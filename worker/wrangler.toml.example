name = "quqn-manager"
main = "worker.js"
compatibility_date = "2026-09-01"

[vars]
GITHUB_OWNER = "YOUR_GITHUB_USERNAME"
GITHUB_REPO = "quqn"
GITHUB_BRANCH = "main"
ALLOWED_ORIGIN = "https://YOUR_GITHUB_USERNAME.github.io"

# Set secrets with Wrangler / Cloudflare dashboard, NEVER here:
# ADMIN_PIN        -> exactly 12 random characters
# SESSION_SECRET   -> long random secret (32+ chars)
# GITHUB_TOKEN     -> fine-grained token, single repo, Contents read/write
# UNISAT_API_TOKEN -> UniSat Open API token
